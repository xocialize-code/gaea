            "selfMaterializing": false,
            "weightSources": [
              {
                "matching": [
                  "transformer/*",
                  "text_encoder/*",
                  "vae/*",
                  "tokenizer/*",
                  "scheduler/*",
                  "*.json"
                ],
                "repo": "mlx-community/Z-Image-Turbo-bf16",
                "revision": "main",
                "role": "snapshot"
              }
