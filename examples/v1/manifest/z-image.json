                "kind": "string",
                "name": "prompt",
                "required": true,
                "summary": "The text prompt."
              },
              {
                "kind": "string",
                "name": "negativePrompt",
                "required": false,
                "summary": "What to steer away from."
              },
              {
                "kind": "integer",
                "name": "width",
                "required": false,
                "summary": "Output width."
              },
              {
                "kind": "integer",
                "name": "height",
                "required": false,
                "summary": "Output height."
              },
              {
                "kind": "integer",
                "name": "steps",
                "required": false,
                "summary": "Denoising steps."
              },
              {
                "kind": "number",
                "name": "guidanceScale",
                "required": false,
                "summary": "CFG scale."
              },
              {
                "kind": "integer",
                "name": "seed",
                "required": false,
                "summary": "RNG seed for reproducibility."
              }
            ],
            "summary": "Z-Image-Turbo 6B text-to-image: distilled 8-step at guidance 0.",
            "supportedModes": []
          },
          {
            "capability": "imageEdit",
            "name": "z-image-turbo-img2img",
            "parameters": [
              {
                "kind": "string",
                "name": "images",
                "required": true,
                "summary": "Conditioning input image(s), in prompt order."
              },
              {
                "kind": "string",
                "name": "prompt",
                "required": true,
                "summary": "The edit instruction."
              },
              {
                "kind": "string",
                "name": "negativePrompt",
                "required": false,
                "summary": "What to steer away from."
              },
              {
                "kind": "integer",
                "name": "width",
                "required": false,
                "summary": "Output width."
              },
              {
                "kind": "integer",
                "name": "height",
                "required": false,
                "summary": "Output height."
              },
              {
                "kind": "integer",
                "name": "steps",
                "required": false,
                "summary": "Denoising steps."
              },
              {
                "kind": "number",
                "name": "guidanceScale",
                "required": false,
                "summary": "True-CFG scale."
              },
              {
                "kind": "integer",
                "name": "seed",
                "required": false,
                "summary": "RNG seed for reproducibility."
              }
            ],
            "summary": "Z-Image-Turbo image-to-image; metaData[\"strength\"] 0–1.",
            "supportedModes": []
          }
        ]
      },
      "title": "Z-Image Turbo"
    }
  ],
  "offers": [
    {
      "operation": "image.generate",
      "profile": "image",
      "model": {
        "id": "z-image-turbo",
        "title": "Z-Image Turbo",
        "license": {
          "spdx": "Apache-2.0",
          "commercial_use": true,
          "terms_url": "https://www.apache.org/licenses/LICENSE-2.0"
        },
        "memory_class": "large",
        "speed_class": "fast",
        "quality_tiers": [
          "draft",
          "standard"
        ],
        "default": true,
        "notes": "Distilled 8-step, no CFG: negative prompts do nothing. Low seed variance is a model trait."
      },
      "defaults": {
        "steps": 8
      },
      "limits": {
        "max_pixels": 2359296,
        "min_side": 256,
        "max_side": 1536,
        "size_multiple": 16
      },
      "params": {
        "type": "object",
        "properties": {
          "x-zimage.shift": {
            "type": "number",
            "minimum": 1,
            "maximum": 6,
            "default": 3,
            "description": "Flow-matching shift; higher favours composition over detail.",
            "x-mes-ui": {
              "widget": "slider",
              "label": "Shift",
              "advanced": true
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "operation": "image.edit",
      "profile": "image",
      "model": {
        "id": "z-image-turbo",
        "title": "Z-Image Turbo (image to image)",
        "license": {
          "spdx": "Apache-2.0",
          "commercial_use": true,
          "terms_url": "https://www.apache.org/licenses/LICENSE-2.0"
        },
        "memory_class": "large",
        "speed_class": "fast",
        "quality_tiers": [
          "draft"
        ],
        "named_only": true,
        "notes": "Re-generates from the input image; strength 0–1 (default 0.75). Not an instruction editor."
      },
      "limits": {
        "max_pixels": 2359296,
        "size_multiple": 16,
        "max_images": 1
      }
    }
  ],
  "helpers": [],
  "settings": [
    {
      "key": "default_lane",
      "title": "Default precision",
      "description": "Which lane Gaea loads when memory allows more than one.",
      "schema": {
        "type": "string",
        "enum": [
          "int4",
          "int8",
          "bf16"
        ],
        "default": "int4"
      },
      "apply": "reload_models"
    }
  ],
  "storage": {
    "schema_version": 1,
    "migrations": [
      "0001_presets"
    ]
  }
}
