      "package": {
        "contractVersion": {
          "major": 1,
          "minor": 57,
          "patch": 0
        },
        "license": {
          "portCodeLicense": {
            "identifier": "MIT"
          },
          "weightLicense": {
            "identifier": "Apache-2.0"
          }
        },
        "provenance": {
          "revision": "main",
          "sourceRepo": "Tongyi-MAI/Z-Image-Turbo",
          "tier": 1
        },
        "requirements": {
          "footprints": [
            {
              "peakActivationBytes": 28000000000,
              "quant": "bf16",
              "residentBytes": 20500000000
            },
            {
              "peakActivationBytes": 28000000000,
              "quant": "int8",
